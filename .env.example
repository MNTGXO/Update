# ─────────────────────────────────────────────────────────────────────────────
#  OTT Updates Bot — Environment Variables
#  Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Telegram Bot Token  →  https://t.me/BotFather → /newbot
BOT_TOKEN=your_telegram_bot_token_here

# Telegram API credentials  →  https://my.telegram.org/apps
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# ── RECOMMENDED ───────────────────────────────────────────────────────────────

# TMDB API key (free)  →  https://www.themoviedb.org/settings/api
# Without this the bot falls back to JustWatch scraping (less reliable).
TMDB_API_KEY=your_tmdb_api_key_here

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# Comma-separated Telegram channel/group IDs to push updates to.
# Example: CHAT_ID=-100123456789,-100987654321
# Leave blank to use per-user subscriptions instead.
CHAT_ID=

# Your Telegram user ID (for /broadcast and /sendnow admin commands)
# Find it by messaging @userinfobot
ADMIN_ID=your_telegram_user_id

# How often the bot checks for new releases (hours, default 6)
UPDATE_INTERVAL_HOURS=6

# Country code for OTT availability (ISO 3166-1 alpha-2)
# Examples: IN, US, GB, AU, CA
JUSTWATCH_COUNTRY=IN

# Language for titles and descriptions
JUSTWATCH_LANGUAGE=en

# Port for the HTTP health-check endpoint (Koyeb/Railway set this automatically)
PORT=8080
