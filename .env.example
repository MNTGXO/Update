# Required
BOT_TOKEN=your_telegram_bot_token_here

# Optional: send to specific channel(s) (comma-separated numeric IDs)
CHAT_ID=

# Optional: check interval in hours (default 6)
UPDATE_INTERVAL_HOURS=6

# JustWatch settings (country code, language)
JUSTWATCH_COUNTRY=US
JUSTWATCH_LANGUAGE=en

# Port for health checks (Koyeb sets this automatically)
PORT=8080
